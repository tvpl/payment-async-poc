# Valores locais sem credenciais reais. Preencha PAYMENT_API_KEY no arquivo .env ignorado.
IMAGE_TAG=local
SANDBOX_NETWORK=payment-sandbox
PAYMENT_CONTRACTS_REPOSITORY_CONTEXT=../payment-contracts/build/repository
FEATURE_CONTROL_REPOSITORY_CONTEXT=../feature-control/build/repo
API_HOST_PORT=8080

MICRONAUT_ENVIRONMENTS=dev
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APICURIO_REGISTRY_URL=http://registry:8080/apis/registry/v2
REDIS_HOST=redis
REDIS_PORT=6379
SBUS_BASE_URL=http://sbus:8081
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Réplicas que compartilham o orçamento de admissão. Mantenha igual ao número real de
# instâncias: é o divisor do orçamento degradado quando o Redis cai.
PAYMENT_API_INSTANCES=1

# Obrigatórios em runtime; obtenha-os do secret manager do ambiente.
PAYMENT_API_KEY=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

# HS256 dev-token signer (MICRONAUT_ENVIRONMENTS=dev only; application-prod.yml never uses this).
JWT_SIGNATURE_SECRET=dev-jwt-signature-secret-change-me-please-32-bytes
