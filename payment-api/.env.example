# Valores locais sem credenciais reais. Preencha PAYMENT_API_KEY no arquivo .env ignorado.
IMAGE_TAG=local
SANDBOX_NETWORK=payment-sandbox
PAYMENT_CONTRACTS_REPOSITORY_CONTEXT=../payment-contracts/build/repository
FEATURE_CONTROL_REPOSITORY_CONTEXT=../feature-control/build/repo
API_HOST_PORT=8080

MICRONAUT_ENVIRONMENTS=dev
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APICURIO_REGISTRY_URL=http://registry:8080/apis/registry/v2
REDIS_HOST=redis
REDIS_PORT=6379
SBUS_BASE_URL=http://sbus:8081
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Réplicas que compartilham o orçamento de admissão. Mantenha igual ao número real de
# instâncias: é o divisor do orçamento degradado quando o Redis cai.
PAYMENT_API_INSTANCES=1

# Obrigatórios em runtime; obtenha-os do secret manager do ambiente.
PAYMENT_API_KEY=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

# Binding tenant (TEN-01/02/03): payment.security.tenants mapeia hash(api-key) -> tenants
# autorizados em application.yml/application-<env>.yml, não como variável de ambiente flat
# (a chave do mapa depende do valor de PAYMENT_API_KEY acima, calculado em tempo de config).
#   1. calcule o hash: printf '%s' "$PAYMENT_API_KEY" | sha256sum | cut -d' ' -f1
#   2. adicione em application.yml: payment.security.tenants."<hash>": ["tenant-a"]
# Sem entrada no binding, a credencial cai no tenant implícito "default" (ver javadoc de
# TenantResolver) enquanto X-Tenant-Id não for enviado; qualquer X-Tenant-Id declarado sem
# binding correspondente responde 403. Produção exige o binding não vazio (boot falha sem ele).

# HS256 dev-token signer (MICRONAUT_ENVIRONMENTS=dev only; application-prod.yml never uses this).
# Deliberately empty, like PAYMENT_API_KEY above: a working secret committed as an "example" is
# the value that ends up in real deployments. Generate a local one, e.g. `openssl rand -hex 32`.
JWT_SIGNATURE_SECRET=
