# Copie para gateway/.env e defina a senha local. O arquivo gateway/.env é ignorado.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Portas expostas no host.
GATEWAY_HOST_PORT=10000
GATEWAY_MTLS_HOST_PORT=10443
GATEWAY_ADMIN_HOST_PORT=9901
# Se mudar esta porta, ajuste também o issuer no envoy/envoy.yaml e o KC_HOSTNAME.
KEYCLOAK_HOST_PORT=8086

# Rede compartilhada criada pelo sandbox (make up lá primeiro).
SANDBOX_NETWORK=payment-sandbox
