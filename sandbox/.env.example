# Copie para sandbox/.env e defina a senha local. O arquivo sandbox/.env é ignorado.
POSTGRES_DB=sbus
POSTGRES_USER=sbus
POSTGRES_PASSWORD=

SANDBOX_NETWORK=payment-sandbox
# SCAL-03: partitions created per topic by sandbox/smoke/init.sh — default 6, double the SBUS
# listeners' own default consumer thread count (3, see payment-sbus's threads config), leaving
# headroom over the AD-007 capacity target without repartitioning later. See
# sandbox/docs/performance.md for the reasoning.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_HOST_PORT=29092
REDIS_HOST_PORT=6379
POSTGRES_HOST_PORT=5432
REGISTRY_HOST_PORT=8085

JAEGER_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
KAFKA_UI_HOST_PORT=8088
