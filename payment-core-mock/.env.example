# NON_PRODUCTION deterministic simulator. Copy to .env for local overrides.
IMAGE_TAG=local
SANDBOX_NETWORK=payment-sandbox
PAYMENT_CONTRACTS_REPOSITORY_CONTEXT=../payment-contracts/build/repository
CORE_MOCK_HOST_PORT=8082

