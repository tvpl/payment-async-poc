# Valores locais sem credenciais reais. Preencha ASYNC_REDIS_SECURITY_API_KEYS no arquivo .env ignorado
# antes de rodar em modo produtivo (MICRONAUT_ENVIRONMENTS=prod).
IMAGE_TAG=local
SANDBOX_NETWORK=payment-sandbox
ASYNC_REDIS_HOST_PORT=8084

MICRONAUT_ENVIRONMENTS=dev
REDIS_HOST=redis
REDIS_PORT=6379

ASYNC_LATENCY_MIN_MS=20
ASYNC_LATENCY_MAX_MS=150
# Identidade do processo no consumer group. Deixe vazio para derivar por instância (RED-04).
ASYNC_INSTANCE_ID=
ASYNC_STREAM_MAXLEN=100000
ASYNC_RETENTION_ALERT_THRESHOLD=0.8
ASYNC_MAX_DELIVERIES=5
ASYNC_POOL_MAX_TOTAL=64

# Produção exige os três gates (RED-08): autenticação, idempotência e admissão. Sem eles o
# startup em MICRONAUT_ENVIRONMENTS=prod recusa (ProductionAcceptanceGuard).
ASYNC_REDIS_SECURITY_ENABLED=true
ASYNC_REDIS_SECURITY_API_KEYS=dev-key-change-me
ASYNC_REDIS_IDEMPOTENCY_REQUIRED=false
ASYNC_ADMISSION_LIMIT=0
