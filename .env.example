# Copie para .env e preencha os campos obrigatórios antes de usar o Compose legado.
# Nunca commite o arquivo .env real.

COMPOSE_PROFILES=observability
PAYMENT_SECURITY_ENABLED=true
API_KEY=
JWT_SIGNATURE_SECRET=
FEATURES_REDIS_ENABLED=true

POSTGRES_DB=sbus
POSTGRES_USER=sbus
POSTGRES_PASSWORD=

KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_RF=1

CORE_LATENCY_MIN_MS=20
CORE_LATENCY_MAX_MS=150
CORE_DECLINE_PCT=10
CORE_FAIL_PCT=2

ASYNC_LATENCY_MIN_MS=20
ASYNC_LATENCY_MAX_MS=150
