# Valores locais sem credenciais reais. Preencha POSTGRES_PASSWORD no arquivo .env ignorado.
IMAGE_TAG=local
SANDBOX_NETWORK=payment-sandbox
PAYMENT_CONTRACTS_REPOSITORY_CONTEXT=../payment-contracts/build/repository
SBUS_HOST_PORT=8081

MICRONAUT_ENVIRONMENTS=dev
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APICURIO_REGISTRY_URL=http://registry:8080/apis/registry/v2
REDIS_URI=redis://redis:6379
# POSTGRES_JDBC_URL only applies under MICRONAUT_ENVIRONMENTS=prod; the dev profile above reads
# the HOST/PORT/DB triple below instead.
POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/sbus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sbus
POSTGRES_USER=sbus
POSTGRES_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Obrigatórios somente em prod; obtenha-os do secret manager do ambiente.
SBUS_JWT_JWKS_URL=
SBUS_JWT_ISSUER=
SBUS_JWT_AUDIENCE=

# HS256 dev-token signer (MICRONAUT_ENVIRONMENTS=dev only; application-prod.yml never uses this).
SBUS_DEV_JWT_SECRET=dev-jwt-signature-secret-change-me-please-32-bytes
